{
  "name": "automation-exercise-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript Playwright UI and API tests for the Automation Exercise demo store",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test tests/api",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.18.0",
    "dotenv": "^16.6.1",
    "typescript": "^5.9.0"
  }
}
